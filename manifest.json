{
  "manifest_version": 3,
  "name": "网页与知网 PDF 入 ima",
  "version": "0.4.0",
  "description": "将网页转为 PDF，或将网页链接及知网原始 PDF 保存到所选 ima 知识库及文件夹",
  "permissions": ["storage", "activeTab", "scripting", "declarativeNetRequest", "cookies", "debugger"],
  "host_permissions": [
    "https://*.cnki.net/*",
    "https://ima.qq.com/*",
    "https://*.myqcloud.com/*"
  ],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [{
    "matches": ["https://*.cnki.net/*"],
    "js": ["src/cnki.js", "src/transfer.js", "src/page-content.js", "src/content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "网页与知网 PDF 入 ima", "default_popup": "popup/popup.html" },
  "options_page": "options/options.html"
}
